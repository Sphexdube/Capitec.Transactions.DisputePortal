{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "DisputePortal",
    "Audience": "DisputePortal.Web",
    "TokenLifetime": "00:15:00",
    "ClockSkew": "00:00:30"
  },
  "DemoAuthentication": {
    "Enabled": false
  },
  "Persistence": {
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05",
    "CommandTimeout": "00:00:30"
  },
  "ConfirmationWorker": {
    "Enabled": true,
    "BatchSize": 50,
    "IdleDelay": "00:00:01",
    "FailureDelay": "00:00:05"
  }
}
